namespace VGF;

table SPIRV {
    words: [uint32];
}

table GLSL {
    code: string;
}

table HLSL {
    code: string;
}

union ModuleCode {
    SPIRV,
    GLSL,
    HLSL
}

enum ModuleType:uint8 {
    COMPUTE,
    GRAPH,
}

table Module {
    type: ModuleType;
    name: string;
    entry_point: string;
    code: ModuleCode;
}

table ModuleTable {
    modules: [Module];
}

table Description {
    shape: [int64];
    strides: [int64];
}

table SamplerConfig {
    min_filter: uint32;
    mag_filter: uint32;
    address_mode_u: uint32;
    address_mode_v: uint32;
    border_color: uint32;
}

enum ScaleFormat:uint8 {
    E8M0,
}

table ScaledTensorConfig {
    block_shape: [uint32];
    scale_format: ScaleFormat;
}

// This union is deprecated and is kept for backward compatibility.
union LegacyExtraConfig {
    SamplerConfig
}

table ExtraConfig {
    sampler_config: SamplerConfig;
    scaled_tensor_config: ScaledTensorConfig;
}

enum ResourceCategory:uint8 {
    INPUT,
    OUTPUT,
    INTERMEDIATE,
    CONSTANT,
}

table ModelResourceTableEntry {
    vk_descriptor_type: uint32; // make the descriptor type opaque on disk
    vk_format: uint32; // make the format opaque on disk
    category: ResourceCategory;
    description: Description;
    legacy_extra_config: LegacyExtraConfig;
    // Optional symmetric alias group identifier shared by MRT entries that use
    // the same storage. When omitted, the MRT entry does not alias peers.
    alias_group_id: uint = 4294967295;
    // Optional resource metadata.
    extra_config: ExtraConfig;
}

table ModelResourceTable {
    mrt_entry: [ModelResourceTableEntry];
}

table BindingSlot {
    binding: uint;
    mrt_index: uint;
}

table DescriptorSetInfo {
    bindings: [BindingSlot];
    // Optional explicit descriptor set index. When omitted, consumers can
    // fall back to descriptor position in SegmentInfo.set_infos.
    // 4294967295 is UINT32_MAX (unset sentinel in schema language).
    set_index: uint = 4294967295;
}

table PushConstantRange {
    stage_flags: uint;
    offset: uint;
    size: uint;
}

table ConstantBinding {
    graph_constant_id: uint;
    constant_table_index: uint;
}

table SegmentInfo {
    type: ModuleType;
    name: string;
    module_index: uint;
    set_infos: [DescriptorSetInfo];
    inputs: [BindingSlot];
    outputs: [BindingSlot];
    constants: [uint];
    dispatch_shape: [uint];
    push_constant_ranges: [PushConstantRange];
    constant_bindings: [ConstantBinding];
}

table ModelSequenceTable {
    segments: [SegmentInfo];
    inputs: [BindingSlot];
    outputs: [BindingSlot];
    input_names: [string];
    output_names: [string];
}

// This section is deprecated and is kept for backward compatibility
table ConstantData {
    mrt_index: uint;
    sparsity_dimension: int64;
    raw: [ubyte] (force_align: 8);
}

// This section is deprecated and is kept for backward compatibility
table ConstantSection {
    data: [ConstantData];
}
