@startuml
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName SansSerif
skinparam ArrowColor #334155
skinparam componentBackgroundColor #EFF6FF
skinparam linetype polyline

component "vgf_dump" as dump
component "argparse" as args
component "nlohmann_json" as json
component "vgf-utils\nFile handling and decoded records" as utils
component "VGF Library\nDecoders" as core

dump -right-> args : CLI parsing
dump -down-> json : JSON output
dump -down-> utils : uses
dump --> core : decodes
utils -down-> core : reads metadata
@enduml
